@@ -0,0 +1,8 @@
+// iOS only: Qt6::Core's link options set the entry point to _qt_main_wrapper,
+// which the qios platform plugin provides for GUI apps. This console host
+// links no platform plugin, so route the wrapper straight to main().
+int main(int argc, char* argv[]);
+extern "C" int qt_main_wrapper(int argc, char* argv[])
+{
+    return main(argc, argv);
+}
